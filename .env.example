# Copia a .env. Nunca subas credenciales al repo.
PORT=3000
ADMIN_PASSWORD=cambia-esto
SESSION_SECRET=cambia-esto-por-un-valor-largo-aleatorio
# IA: configura al menos una clave. El proveedor activo se elige en la pestaña "IA" (o con LLM_PROVIDER).
# LLM_PROVIDER=anthropic   # anthropic | openai | deepseek
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Modelos opcionales (también editables en la pestaña "IA"):
# ANTHROPIC_MODEL=claude-sonnet-5
# Presupuesto máximo de salida por llamada (la app ajusta uno por tipo de pieza).
# LLM_MAX_TOKENS=4000
# OPENAI_MODEL=gpt-4o
# Modelos vigentes: deepseek-flash (predeterminado) o deepseek-v4-pro.
# DEEPSEEK_MODEL=deepseek-flash
# Para JSON/carruseles se usa pensamiento desactivado por defecto; habilítalo solo si lo necesitas.
# DEEPSEEK_THINKING=enabled
# Meta (Instagram) API oficial: token de larga duración (~60 días). Ver docs/CONECTAR-PLATAFORMAS.md
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
